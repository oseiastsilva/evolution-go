# Copie para ".env" (na raiz desta pasta) e ajuste. NUNCA commite o .env real.
# Sem .env, o docker-compose usa os padrões de desenvolvimento do compose.

# Senha do Postgres local (a mesma entra nas DSNs do Evo Go automaticamente)
POSTGRES_PASSWORD=postgres

# Chave global da API do Evo Go (header apikey nas chamadas administrativas)
GLOBAL_API_KEY=dev-global-api-key-troque

# Portas publicadas no host
EVOGO_PORT=8080
POSTGRES_PORT=5433

# Debug do whatsmeow (INFO, DEBUG)
WADEBUG=INFO

# true = conecta todas as instâncias pareadas ao subir (cuidado: instância
# sem pareamento entra em loop de QR — deixe false e conecte manualmente)
CONNECT_ON_STARTUP=false
